# Keep LF for shell scripts also in the Windows working copy,
# so that core.autocrlf does not change them to CRLF.
*.sh text eol=lf

# The font tables are generated by tools/fontgen and are large.
# Do not show their content in diffs.
components/gfx/fonts/*.c -diff linguist-generated=true

*.ttf binary
*.png binary
*.bin binary
