# Copy this file to sdkconfig.secrets (in the same project folder) and set your values.
# sdkconfig.secrets is in .gitignore.
#
# These are only the start values. The settings page of the device changes them
# and keeps them in NVS. "BOOT 10 s" erases NVS: then these values apply again.
#
# ESP-IDF reads this file only when it makes a new sdkconfig: after a change,
# delete sdkconfig and build again.
CONFIG_RLCD_WIFI_SSID="my-wifi"
CONFIG_RLCD_WIFI_PASSWORD="my-password"

# Home Assistant: Profile -> Security -> Long-lived access tokens
#CONFIG_RLCD_HA_URL="http://homeassistant.local:8123"
CONFIG_RLCD_HA_TOKEN="eyJ..."
# Entities: the main one first, then the backups, separated by commas
#CONFIG_RLCD_E_TEMP="sensor.outdoor_temperature"
#CONFIG_RLCD_E_HUM="sensor.outdoor_humidity"
#CONFIG_RLCD_E_AQI="sensor.outdoor_air_quality_index"
#CONFIG_RLCD_E_VOLT="sensor.ups_input_voltage"
#CONFIG_RLCD_E_UPS="sensor.ups_status"
#CONFIG_RLCD_E_DRONE="binary_sensor.air_alert_yellow"
#CONFIG_RLCD_E_MISSILE="binary_sensor.air_alert_red"
#CONFIG_RLCD_E_OFF="sensor.power_next_off"
#CONFIG_RLCD_E_ON="sensor.power_next_on"
#CONFIG_RLCD_POWER_QUEUE="черга 1.1"
# Forecast: the WMO index of a meteo.gov.ua station (33345 = Kyiv); alerts without HA: a region of ubilling.net.ua
#CONFIG_RLCD_METEO_STATION="33345"
#CONFIG_RLCD_ALERT_REGION="м. Київ"

# DTEK power from a healthchecks.io check (Project Settings -> API Access -> read-only key)
#CONFIG_RLCD_HC_KEY="read-only-key"
#CONFIG_RLCD_HC_CHECK="check-slug"

# Optional
#CONFIG_RLCD_WIFI2_SSID="backup-wifi"
#CONFIG_RLCD_WIFI2_PASSWORD="backup-password"
#CONFIG_RLCD_DNS1="192.168.1.1"
#CONFIG_RLCD_MQTT_URI="mqtt://homeassistant.local:1883"
#CONFIG_RLCD_MQTT_USER="user"
#CONFIG_RLCD_MQTT_PASSWORD="password"
#CONFIG_RLCD_WEB_PASSWORD="page-password"

# The image of the "З сервера" screen and the firmware archive for the update
#CONFIG_RLCD_SERVER_URL="http://server:15000/quad.bmp"
#CONFIG_RLCD_OTA_URL="http://server/dl/rlcd-dashboard-0.1.0.tar"
